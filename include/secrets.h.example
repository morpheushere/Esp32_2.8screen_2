// Copy this file to secrets.h and fill in your real values.
// secrets.h is gitignored -- never commit real credentials.

#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// The strava-heatmap-pwa nginx container, which proxies /api/weather/current
// to the Flask API backed by InfluxDB.
#define WEATHER_API_HOST "10.0.0.111"
#define WEATHER_API_PORT 8890
#define WEATHER_API_PATH "/api/weather/current"

// Same backend, Spotify now-playing tab. The backend syncs from Spotify
// every 5s server-side into a local cache -- these just read that cache,
// no external API cost per device poll.
#define SPOTIFY_API_PATH "/api/spotify/now-playing"
#define SPOTIFY_ART_PATH "/api/spotify/art.raw"
